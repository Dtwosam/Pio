[Unit]
Description=Pio Phase 2 bounded read-only evidence collection step
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pio
Group=pio
WorkingDirectory=/opt/pio
EnvironmentFile=/etc/pio/pio.env
ExecStart=/opt/pio/python-learner/.venv/bin/python -m meteora_learner.phase2_evidence_cycle --executor /opt/pio/rust-executor/target/release/meteora-executor --persist-progress
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pio/data
