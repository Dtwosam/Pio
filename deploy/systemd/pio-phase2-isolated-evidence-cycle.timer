[Unit]
Description=Run Pio isolated Phase 2 evidence cycle periodically
Conflicts=pio-phase2-position-observer.timer pio-phase2-evidence-cycle.timer

[Timer]
OnBootSec=10min
OnUnitActiveSec=15min
AccuracySec=1min
Persistent=true
Unit=pio-phase2-isolated-evidence-cycle.service

[Install]
WantedBy=timers.target
