[Unit]
Description=Pio Phase 2 event-driven prestate stream
After=network-online.target
Wants=network-online.target
Conflicts=pio-phase2-prestate-watch.service
ConditionPathIsExecutable=/opt/pio-phase2-runtime/current/rust-executor/target/release/meteora-executor

[Service]
Type=simple
User=pio
Group=pio
WorkingDirectory=/opt/pio-phase2-runtime/current
EnvironmentFile=/etc/pio/pio.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/pio-phase2-runtime/current/python-learner/src
ExecStart=/opt/pio/python-learner/.venv/bin/python -m meteora_learner.phase2_event_prestate --executor /opt/pio-phase2-runtime/current/rust-executor/target/release/meteora-executor --cache-database /opt/pio/data/phase2-prestate-cache.db
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/pio-phase2-runtime/current
ReadWritePaths=/opt/pio/data

[Install]
WantedBy=multi-user.target
