[Unit]
Description=Pio Phase 9 replay-aware research refresh
After=pio-phase9-source-capture.service

[Service]
Type=oneshot
User=pio
Group=pio
WorkingDirectory=/opt/pio
EnvironmentFile=/etc/pio/pio.env
ExecStart=/opt/pio/python-learner/.venv/bin/pio phase9-research-refresh-run $PIO_PHASE9_RESEARCH_REFRESH_EXTRA_ARGS
TimeoutStartSec=20min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pio/data
